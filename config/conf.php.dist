// $conf['storage']['params']['ssl'] = false;
$conf['storage']['params']['driverconfig'] = 'horde';
// Database table
$conf['storage']['params']['table'] = 'cdr';
// Maximum number of records to include in CDR searches. Does not apply to graphs.
$conf['storage']['searchlimit'] = 5000;
